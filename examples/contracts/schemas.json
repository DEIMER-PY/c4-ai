{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DEIMER-PY/c4-ai/blob/develop/examples/contracts/schemas.json",
  "title": "C4 AI v1 contracts",
  "$defs": {
    "Agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_ref": {
          "type": "string",
          "minLength": 1
        },
        "config_ref": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "prompt_ref",
        "config_ref",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "input_payload": {
          "type": "object"
        },
        "output_payload": {
          "type": "object"
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cost_usd"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "agent_id",
        "status",
        "input_payload",
        "output_payload",
        "trace",
        "latency_ms",
        "usage",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Incident": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "policy_violation",
            "tool_failure",
            "hallucination",
            "missing_context",
            "routing_failure",
            "recovery_failure",
            "security"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "detected",
            "diagnosing",
            "patch_proposed",
            "evaluating",
            "resolved",
            "rejected",
            "needs_human_review"
          ]
        }
      },
      "required": [
        "id",
        "run_id",
        "category",
        "severity",
        "summary",
        "root_cause",
        "status"
      ],
      "additionalProperties": false
    },
    "Patch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_type": {
          "type": "string",
          "enum": [
            "prompt",
            "config"
          ]
        },
        "diff": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "proposed",
            "evaluating",
            "accepted",
            "rejected",
            "needs_human_review"
          ]
        }
      },
      "required": [
        "id",
        "incident_id",
        "baseline_agent_id",
        "candidate_agent_id",
        "patch_type",
        "diff",
        "rationale",
        "approval_status"
      ],
      "additionalProperties": false
    },
    "Score": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed",
        "total"
      ],
      "additionalProperties": false
    },
    "CaseResult": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "before_passed": {
          "type": "boolean"
        },
        "after_passed": {
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "before_passed",
        "after_passed"
      ],
      "additionalProperties": false
    },
    "Evaluation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "$ref": "#/$defs/Score"
        },
        "after": {
          "$ref": "#/$defs/Score"
        },
        "regressions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "security_passed": {
          "type": "boolean"
        },
        "target_case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseResult"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "patch_id",
        "dataset_id",
        "dataset_version",
        "before",
        "after",
        "regressions",
        "security_passed",
        "target_case_id",
        "case_results",
        "status"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "additionalProperties": false
    },
    "Job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "inspect",
            "diagnose",
            "patch",
            "evaluate",
            "decide",
            "report"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "incident_id",
        "stage",
        "status",
        "attempts",
        "error",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "needs_human_review"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "incident_id",
        "patch_id",
        "evaluation_id",
        "decision",
        "summary",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "synthetic": {
      "const": true
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Agent"
      }
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "incident": {
      "$ref": "#/$defs/Incident"
    },
    "patch": {
      "$ref": "#/$defs/Patch"
    },
    "evaluation": {
      "$ref": "#/$defs/Evaluation"
    },
    "job": {
      "$ref": "#/$defs/Job"
    },
    "report": {
      "$ref": "#/$defs/Report"
    }
  },
  "required": [
    "synthetic",
    "agents",
    "run",
    "incident",
    "patch",
    "evaluation",
    "job",
    "report"
  ],
  "additionalProperties": false
}
