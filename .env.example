# Copiar a .env local. Nunca colocar credenciales en esta plantilla versionada.
C4_ENV=local
C4_GROK_BASE_URL=https://api.reto.pltk.mx/v1
# Ejemplo publicado; verificar habilitación en el panel antes de llamadas reales.
C4_GROK_MODEL=grok-4.7
C4_GROK_API_KEY=
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
C4_MODEL_TIMEOUT_SECONDS=60
C4_MAX_FIX_ATTEMPTS=3
C4_MAX_JOB_SECONDS=600
C4_MAX_MODEL_CALLS=16
C4_MAX_OUTPUT_TOKENS=1024
# Reservadas para el gate monetario futuro. El CLI limita llamadas/tokens/tiempo;
# no puede garantizar un gasto en USD sin tarifas verificadas del gateway.
C4_JOB_BUDGET_USD=
C4_DAILY_BUDGET_USD=
C4_ALLOWED_ORIGINS=http://localhost:3000
