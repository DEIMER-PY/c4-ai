# Copiar a .env local. Nunca colocar credenciales en esta plantilla versionada.
C4_ENV=local
C4_GROK_BASE_URL=https://api.reto.pltk.mx/v1
# Ejemplo publicado; verificar habilitación en el panel antes de llamadas reales.
C4_GROK_MODEL=grok-4.7
C4_GROK_API_KEY=
# Opcional: agente evaluado en Groq; razonamiento de C4 permanece en Grok.
C4_TARGET_PROVIDER=grok
C4_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Elegir ID habilitado en la cuenta, p. ej. qwen/qwen3.8-27b.
C4_GROQ_MODEL=
GROQ_API_KEY=
# Opcional: agente evaluado en DeepSeek
C4_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
C4_DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# Opcional: agente evaluado localmente con Ollama ($0.00 USD)
C4_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
C4_OLLAMA_MODEL=qwen2.5:7b
# Opcional: triage probabilistico JEV (System One TypeSafe AI)
TYPESAFE_API_KEY=
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
C4_MODEL_TIMEOUT_SECONDS=60
# Intentos de reparación por sesión (1..5). Cada intento extra cuesta 1 + N casos llamadas;
# con refunds_v2 (32 casos), 2 intentos = 99 llamadas más reintentos del gateway: usar C4_MAX_MODEL_CALLS=120 (tope 200).
C4_MAX_FIX_ATTEMPTS=2
C4_MAX_JOB_SECONDS=600
# 16 alcanza para refunds.json (14 llamadas); refunds_v2.json (32 casos) necesita 66 o más: usar 80.
C4_MAX_MODEL_CALLS=16
# Reintentos por llamada ante timeout, conexión o 5xx (el 429 no se reintenta). 0..5.
C4_MAX_PROVIDER_RETRIES=2
C4_MAX_OUTPUT_TOKENS=1024
# Reservadas para el gate monetario futuro. El CLI limita llamadas/tokens/tiempo;
# no puede garantizar un gasto en USD sin tarifas verificadas del gateway.
C4_JOB_BUDGET_USD=
C4_DAILY_BUDGET_USD=
C4_ALLOWED_ORIGINS=http://localhost:3000
